{
  "id": "core", "name": "Generic", "extends": [],
  "nodeTypes": [
    {"id": "core.place", "icon": "map-pin", "label": "Place", "codePrefix": "P", "campaignMap": {"shape": "circle"}},
    {
      "id": "core.pc", "icon": "user", "label": "Player character", "codePrefix": "PC",
      "linkSlots": [{"label": "Location", "rels": ["located_at:out"]}]
    },
    {
      "id": "core.npc", "icon": "drama", "label": "NPC", "codePrefix": "N",
      "linkSlots": [{"label": "Location", "rels": ["located_at:out"]}],
      "overview": {"columns": ["voice", "appearance", "dead"], "muted": "dead"},
      "print": {"summary": {"parts": ["{voice}", "{appearance}", "{dead}"]}},
      "props": {
        "voice": {"type": "string", "title": "Voice", "x-wide": true},
        "appearance": {"type": "string", "title": "Appearance", "x-wide": true},
        "dead": {"type": "boolean", "title": "Dead", "x-trueLabel": "dead"}
      }
    },
    {
      "id": "core.item", "icon": "package", "label": "Item", "codePrefix": "I",
      "linkSlots": [{"label": "Location / carried by", "rels": ["located_at:out", "carries:in"]}]
    },
    {"id": "core.faction", "icon": "flag", "label": "Faction", "codePrefix": "G"},
    {"id": "core.fact", "icon": "scroll-text", "label": "Fact", "codePrefix": "F"},
    {
      "id": "core.session", "icon": "calendar", "label": "Session", "codePrefix": "S",
      "overview": {"sort": "date", "columns": ["date"]},
      "props": {
        "number": {"type": "integer", "title": "Session #", "minimum": 0},
        "date": {"type": "string", "title": "Date", "format": "date"},
        "recap": {"type": "string", "title": "What happened", "x-widget": "textarea", "x-wide": true}
      }
    }
  ],
  "edgeTypes": [
    {"id": "relates_to", "label": "relates to", "inverseLabel": "relates to", "from": ["*"], "to": ["*"]},
    {
      "id": "located_at", "label": "is located at", "inverseLabel": "has here",
      "from": ["core.npc", "core.pc", "core.item", "core.faction"], "to": ["core.place"], "groupByType": true
    },
    {
      "id": "knows", "label": "knows", "inverseLabel": "is known by", "from": ["core.npc", "core.pc", "core.faction"],
      "to": ["core.fact"]
    },
    {"id": "about", "label": "is about", "inverseLabel": "facts", "from": ["core.fact"], "to": ["*"]},
    {
      "id": "carries", "label": "carries", "inverseLabel": "carried by", "from": ["core.npc", "core.pc"],
      "to": ["core.item"]
    },
    {
      "id": "member_of", "label": "is member of", "inverseLabel": "members", "from": ["core.npc", "core.pc"],
      "to": ["core.faction"]
    },
    {"id": "features", "label": "features", "inverseLabel": "featured in", "from": ["core.session"], "to": ["*"]},
    {
      "id": "plans_reveal", "label": "plans to reveal", "inverseLabel": "reveal planned in", "from": ["core.session"],
      "to": ["core.fact"]
    }
  ]
}
