{#
  A node's body in MÖRK BORG prints: props (stats, a dungeon's state), option descriptions, notes, links (a dungeon's
  rooms nested with the creatures and items in them), facts with tick boxes. Model: a node print model.
  Used by the A4 print (place.peb) and the session packet (session.peb), so both print the same content.
#}
  {% if props is not empty %}
  <table class="props">
    {% for p in props %}
      {% if p.details is empty %}<tr><td class="k">{{ p.label }}</td><td>{% if p.track is not null %}{% include "print/_track.peb" %}{% elseif p.items is not empty %}{% include "print/_items.peb" %}{% elseif p.html is not empty %}<div class="body">{{ p.html | raw }}</div>{% else %}{{ p.value }}{% endif %}</td></tr>
      {% elseif not p.multi %}{% for t in p.details %}<tr><td class="k">{{ p.label }}</td><td><span class="t">{{ t.option }}</span>: {{ t.text }}</td></tr>{% endfor %}
      {% endif %}
    {% endfor %}
  </table>
  {% include "print/_linked_props.peb" %}
  {% endif %}

  {# Multi-choice props with option descriptions (e.g. resource tags) get their own section, so the meaning is on the card. #}
  {% for p in props %}{% if p.multi and p.details is not empty %}
    <h4>{{ p.label }}</h4>
    {% for t in p.details %}<div class="detail"><span class="t">{{ t.option }}</span>: {{ t.text }}</div>{% endfor %}
  {% endif %}{% endfor %}

  {% if node.body is not empty %}<div class="body">{{ notes | raw }}</div>{% endif %}

  {% for g in groups %}
    <h4>{{ g.label }}</h4>
    <ul>{% for i in g.items %}<li>{{ i.title }} <span class="ref">({{ i.code }})</span>{% if i.summary is not empty %}: {{ i.summary | raw }}{% endif %}{% if i.children is not empty %}<ul class="nested">{% for c in i.children %}<li>{{ c.title }} <span class="ref">({{ c.code }})</span>{% if c.summary is not empty %}: {{ c.summary | raw }}{% endif %}</li>{% endfor %}</ul>{% endif %}</li>{% endfor %}</ul>
  {% endfor %}

  {% if facts is not empty %}
    <h4>{% if audience == 'gm' %}Secrets &amp; facts{% else %}What you know{% endif %}</h4>
    {% for f in facts %}
      <div class="fact">{% if audience == 'gm' %}<span class="box"></span>{% endif %}<span class="t">{{ f.title }}</span>{% if f.body is not empty %}: {{ f.notes | raw }}{% endif %}</div>
    {% endfor %}
  {% endif %}
