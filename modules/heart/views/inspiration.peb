{% extends "layout.peb" %}
{#
  GM inspiration: what the party's characters want from play. Heart module view over heart.pc.
  Model: campaign, module, nodes (ViewNode: node + fields by name), groups["calling"], groups["class"]
  (ViewGroup: value, label, hint = the class text from "x-enumDescriptions", nodes).
#}
{% block title %}Inspiration · {{ campaign.name }}{% endblock %}
{% block crumbs %}
  <span class="sep">/</span> <a href="/c/{{ campaign.id }}">{{ campaign.name }}</a>
  <span class="sep">/</span> Inspiration
{% endblock %}

{% block content %}
<h1>Inspiration</h1>
{% if nodes is not empty %}
{% include "heart/views/_inspiration.peb" with {"links": true} %}
{% endif %}
{% endblock %}
