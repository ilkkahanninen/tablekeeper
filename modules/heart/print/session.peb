<!doctype html>
{#
  Heart session packet: one brief landscape A4 document for the next session, in two parts (variable `part`):
  - "cover": the session's title and notes, and the whole map with the selected places filled red;
    with a previous session's recap (packet "recap"), that recap beside the map, "Last time";
  - "columns": the selected characters' Inspiration, then a section per selected landmark and delve between them.
    Laid out as one column on narrow pages, which the app places three to a sheet (packet "columns": 3).
  No part (the HTML preview) shows both. Model: the session's print model plus map, views, sections.
#}
<html>
<head>
<meta charset="utf-8">
<title>{{ node.code }} {{ node.title }}</title>
<style>
  @page { size: A4 landscape; margin: 10mm; }
  body { font-family: serif; font-size: 9.5pt; color: #111; margin: 0; line-height: 1.3; }
  header { border-bottom: 0.6mm solid #111; margin-bottom: 2mm; }
  h1 { font-size: 15pt; margin: 0 0 1mm; }
  .date { font-size: 9pt; color: #555; margin-left: 2mm; font-weight: normal; }
  .notes { margin: 1mm 0 2mm; }
  .code, .ref { font-family: monospace; font-size: 8pt; color: #555; }
  h2 { font-size: 9pt; text-transform: uppercase; letter-spacing: 0.6pt; color: #8c1c13; border-bottom: 0.3mm solid #8c1c13; margin: 4mm 0 2mm; padding-bottom: 0.5mm; page-break-after: avoid; }
  .text > h2:first-child { margin-top: 0; }
  h3 { font-size: 12pt; margin: 4mm 0 1mm; page-break-after: avoid; }
  .place { page-break-inside: avoid; margin-bottom: 3mm; }
  .flag { font-size: 7pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5pt; color: #8c1c13; vertical-align: middle; }

  /* Place body (shared _place.peb), as on the cards but on A4 */
  .props { border-collapse: collapse; margin-bottom: 1.5mm; }
  .props td { padding: 0.4mm 3mm 0.4mm 0; vertical-align: top; }
  .props td.k { color: #555; font-size: 7.5pt; text-transform: uppercase; white-space: nowrap; }
  .props .t, .detail .t, .fact .t { font-weight: bold; }
  .body { margin: 1mm 0; }
  /* Formatted notes (Notes.html): paragraphs and lists; [[mentions]] in bold */
  .body p, .notes p { margin: 0 0 1.5mm; }
  .body ul, .notes ul { margin: 0 0 1.5mm; padding-left: 4.5mm; }
  .body > :last-child, .notes > :last-child { margin-bottom: 0; }
  h4 { font-size: 7.5pt; text-transform: uppercase; letter-spacing: 0.5pt; color: #555; margin: 2mm 0 0.5mm; }
  ul { margin: 0; padding-left: 4.5mm; list-style: disc; }
  li { margin: 0 0 0.6mm 0; }
  ul.nested { list-style: circle; margin-top: 0.6mm; }
  .fact, .detail { margin: 0 0 1mm 0; }
  /* Resistance track ("x-track") and events ("list", formatted like notes), ticked off at the table */
  .track { line-height: 6mm; }
  .pip { display: inline-block; width: 4.6mm; height: 4.6mm; line-height: 4.6mm; border: 0.3mm solid #111; margin: 0 0.8mm 0.8mm 0;
         text-align: center; font-size: 6pt; color: #777; vertical-align: middle; }
  .item { margin: 0 0 1.5mm 0; }
  .item .box + p { display: inline; }
  .item p { margin: 0 0 1mm; }
  .item ul { margin: 0 0 1mm; padding-left: 4.5mm; }
  .long-text { white-space: pre-wrap; margin: 1mm 0; }
  .box { display: inline-block; width: 2.6mm; height: 2.6mm; border: 0.3mm solid #111; margin-right: 1mm; vertical-align: -0.3mm; }

  /* Inspiration body (shared _inspiration.peb) */
  .inspiration section { margin: 0; }
  .inspiration h2 { font-size: 8pt; color: #555; border-bottom: none; margin: 3mm 0 1mm; }
  .card { page-break-inside: avoid; margin: 0 0 2mm; }
  .group-title { font-size: 10.5pt; margin: 1.5mm 0 0.5mm; }
  .who { margin: 0.5mm 0; }
  .muted, .small { color: #555; font-size: 8.5pt; }
  .beats { margin: 0 0 1mm; }
  .beat-type { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.4pt; color: #8c1c13; margin-right: 1mm; }
  .wants { margin: 0.5mm 0 0; }
  .linked-label { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.4pt; color: #555; margin: 1.5mm 0 0.3mm; }
  .character { page-break-inside: avoid; margin-bottom: 3mm; }
  .role { color: #555; font-size: 8.5pt; margin: 0 0 0.5mm; }

  /* Cover with the previous session's recap ("Last time") beside the map */
  table.cover { border-collapse: collapse; width: 100%; }
  .cover td { vertical-align: top; padding: 0; }
  .last-time { padding-left: 5mm; }
  .last-time h2 { margin-top: 0; }
</style>
</head>
<body>
  {% if part != 'columns' %}
  <div class="map-page">
    <header>
      <h1><span class="code">{{ node.code }}</span> {{ node.title }}{% for p in props %}{% if p.name == 'date' %}<span class="date">{{ p.value }}</span>{% endif %}{% endfor %}</h1>
      {% if node.body is not empty %}<div class="notes">{{ notes | raw }}</div>{% endif %}
    </header>
    {% if previous is not null %}
      {# The previous session's recap beside a smaller map, so the cover stays one page #}
      <table class="cover"><tr>
        <td class="cover-map">{% if map.places is not empty %}{% include "map/_svg.peb" with {"links": false, "svgWidth": 760, "svgHeight": 537} %}{% endif %}</td>
        <td class="last-time">
          <h2>Last time</h2>
          <div class="ref">{{ previous.code }} {{ previous.title }}</div>
          <div class="notes">{{ previous.notes | raw }}</div>
        </td>
      </tr></table>
    {% elseif map.places is not empty %}{% include "map/_svg.peb" with {"links": false, "svgWidth": 1000, "svgHeight": 640} %}{% endif %}
  </div>
  {% endif %}

  {% if part != 'cover' %}
  <div class="text">
  {% for v in views %}
    {% if v.view.id == 'inspiration' %}
      <h2>Characters</h2>
      {# One block per character: calling · class, notes, beats, fallouts, and the class's inspiration points.
         Characters sharing a class: the points print only under the first of them (the class group's first node). #}
      {% for c in v.nodes %}
        <div class="character">
          <h3><span class="code">{{ c.node.code }}</span> {{ c.display }}</h3>
          {% if c.fields.calling.text is not empty or c.fields.class.text is not empty %}
            <div class="role">{{ c.fields.calling.text }}{% if c.fields.calling.text is not empty and c.fields.class.text is not empty %} · {% endif %}{{ c.fields.class.text }}</div>
          {% endif %}
          {% if c.node.body is not empty %}<div class="body">{{ c.notes | raw }}</div>{% endif %}
          {% if c.fields.beat1.text is not empty or c.fields.beat2.text is not empty %}
            <div class="linked-label">Beats</div>
            <ul class="beats">
              {% if c.fields.beat1.text is not empty %}<li>{% if c.fields.beat1Type.text is not empty %}<span class="beat-type">{{ c.fields.beat1Type.text }}</span> {% endif %}{{ c.fields.beat1.text }}</li>{% endif %}
              {% if c.fields.beat2.text is not empty %}<li>{% if c.fields.beat2Type.text is not empty %}<span class="beat-type">{{ c.fields.beat2Type.text }}</span> {% endif %}{{ c.fields.beat2.text }}</li>{% endif %}
            </ul>
          {% endif %}
          {% for lg in c.linked %}
            <div class="linked-label">{{ lg.label }}</div>
            <ul>{% for i in lg.items %}<li>{{ i.title }} <span class="ref">({{ i.code }})</span>{% if i.summary is not empty %}: {{ i.summary }}{% endif %}</li>{% endfor %}</ul>
          {% endfor %}
          {% for g in v.groups["class"] %}
            {% if g.hint is not null and g.value == c.fields.class.value and g.nodes[0].node.code == c.node.code %}
              <div class="linked-label">{{ g.label }}</div>
              <ul class="wants">{% for w in g.hint | split('; ') %}<li>{{ w }}</li>{% endfor %}</ul>
            {% endif %}
          {% endfor %}
        </div>
      {% endfor %}
    {% endif %}
  {% endfor %}

  {% for s in sections %}
    <h2>{{ s.label }}</h2>
    {% for item in s.items %}
      <div class="place">
        <h3><span class="code">{{ item.node.code }}</span> {{ item.displayTitle }}{% for f in item.flags %} <span class="flag">{{ f }}</span>{% endfor %}</h3>
        {# Pebble's include takes a literal map: pass the place's print model through #}
        {% include "heart/print/_place.peb" with {"node": item.node, "props": item.props, "linkedProps": item.linkedProps,
            "groups": item.groups, "facts": item.facts, "audience": item.audience, "notes": item.notes} %}
      </div>
    {% endfor %}
  {% endfor %}
  </div>
  {% endif %}
</body>
</html>
