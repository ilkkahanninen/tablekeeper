<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{% block title %}Tablekeeper{% endblock %}</title>
  <link rel="stylesheet" href="/static/app.css">
  <script src="/static/htmx.min.js" defer></script>
  <script src="/static/app.js" defer></script>
</head>
<body>
  <header class="top">
    <a class="brand" href="/">Tablekeeper</a>
    {% block crumbs %}{% endblock %}
    {# On every campaign page: campaign-wide pages (the map is linked from the campaign page), and create any kind of node (named from its random tables, or "New <type>"), then open it #}
    {% if campaign is not null and module is not null %}
      <nav class="top-nav">
        {% for v in module.views %}<a href="/c/{{ campaign.id }}/v/{{ v.id }}">{{ v.label }}</a>{% endfor %}
        <a href="/c/{{ campaign.id }}/tables">Tables</a>
      </nav>
      {# Quick find: "/" or Ctrl/⌘ K from anywhere (app.js) #}
      <div class="top-find" role="search">
        <span class="type-icon find-icon" aria-hidden="true"><svg><use href="/static/icons.svg#search"/></svg></span>
        <input id="find-q" type="search" name="q" aria-label="Find" title="Find (/)" autocomplete="off"
               hx-get="/c/{{ campaign.id }}/find" hx-trigger="input changed delay:150ms, focus" hx-target="#find-results">
        <div id="find-results" class="menu find-results" role="listbox"></div>
      </div>
      {# Create ▾: a menu of node types (icon + name, A–Z); picking one posts its "type" and opens the new node. Then the game's
         generators, which post to their own route (formaction) and open what they made. #}
      <details class="dropdown top-create">
        <summary class="primary">Create ▾</summary>
        <form class="menu dropdown-choices" method="post" action="/c/{{ campaign.id }}/nodes">
          {% for t in module.nodeTypes %}<button class="menu-item" name="type" value="{{ t.id }}"><span class="type-icon" aria-hidden="true"><svg><use href="/static/icons.svg#{{ module.icon(t.id) }}"/></svg></span> {{ t.label }}</button>{% endfor %}
          {# The game's generators: a whole thing (a dungeon with its rooms) in one click #}
          {% if module.generators is not empty %}<hr class="menu-sep">{% endif %}
          {% for g in module.generators %}<button class="menu-item" formaction="/c/{{ campaign.id }}/generate/{{ g.id }}"><span class="type-icon" aria-hidden="true"><svg><use href="/static/icons.svg#dices"/></svg></span> Generate {{ g.label | lower }}</button>{% endfor %}
        </form>
      </details>
    {% endif %}
  </header>
  <main>
    {% block content %}{% endblock %}
  </main>
</body>
</html>
