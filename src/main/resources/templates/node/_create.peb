{# "Add new": create a node linked to this one, then open it: a button per type it can be (the clicked one's "choice" is posted).
   It's named from the type's random tables (or "New <type>") and opens with the name selected, to type over. Its own box, shown when the type offers something to create; sent out-of-band after link changes
   (a full link type drops out of the choices). #}
<section id="create-row" class="card"{% if quickCreate is empty %} hidden{% endif %}{% if oob %} hx-swap-oob="true"{% endif %}>
  {% if quickCreate is not empty %}
    <h2>Add new</h2>
    <form class="create-row" hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/quick-create">
      {% for c in quickCreate %}<button class="secondary" name="choice" value="{{ c.key }}">{{ c.label }}</button>{% endfor %}
    </form>
  {% endif %}
</section>
