{# Link box create row: always visible. Title = the text typed in the Link box (#link-q), or "New <type>" if empty.
   Create opens the new node; ↓ creates it without leaving. Sent out-of-band after link changes. #}
<div id="create-row"{% if oob %} hx-swap-oob="true"{% endif %}>
  {% if quickCreate is not empty %}
    <form class="create-row" hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/quick-create" hx-include="#link-q">
      <select name="choice" aria-label="Create as">
        {% for c in quickCreate %}<option value="{{ c.key }}">{{ c.label }}</option>{% endfor %}
      </select>
      <button>Create</button>
      <button type="button" class="stay" aria-label="Create without opening" title="Create without opening"
              hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/quick-create" hx-vals='{"stay": "1"}' hx-include="#link-q, closest form"
              hx-target="#linked" hx-swap="outerHTML" data-clear-search>↓</button>
    </form>
  {% endif %}
</div>
