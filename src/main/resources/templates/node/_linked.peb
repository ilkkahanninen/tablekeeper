{# This node's links, grouped by relation. Swapped after link changes, so the element is always present. #}
<section id="linked"{% if groups is not empty %} class="card"{% endif %}>
  {% if groups is not empty %}<h2>Links</h2>{% endif %}
  {% for g in groups %}
    <h3>{{ g.label }}</h3>
    <ul class="plain">
      {% for l in g.links %}
        <li>
          <span class="code">{{ l.code }}</span>
          <a href="/c/{{ campaign.id }}/n/{{ l.otherId }}">{{ l.title }}</a>
          {% if l.edgeId is not null %}<button class="unlink" aria-label="Remove link"
                  hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/links/{{ l.edgeId }}/delete"
                  hx-target="#linked" hx-swap="outerHTML">×</button>{% endif %}
        </li>
      {% endfor %}
    </ul>
  {% endfor %}
</section>
