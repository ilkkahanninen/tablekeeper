{# Link slot dropdowns (module "linkSlots"), e.g. Location = a place or a carrier. Sent out-of-band after link changes. #}
<div id="link-slots" class="link-slots"{% if oob %} hx-swap-oob="true"{% endif %}>
  {% for s in slots %}
    <form hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/slot" hx-trigger="change" hx-target="#linked" hx-swap="outerHTML">
      <input type="hidden" name="slot" value="{{ s.index }}">
      <label>{{ s.label }}
        {% include "node/_slot_select.peb" with {"s": s, "label": false} %}
      </label>
    </form>
  {% endfor %}
</div>
