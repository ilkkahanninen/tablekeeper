{# One debrief line (variables target: the node it saves to, r: DebriefRow). Saves just its own fields ("only"), so the
   rest of the node is untouched; Done empties them (e.g. a finished beat) and reloads the debrief. #}
<form class="debrief-row" hx-post="/c/{{ campaign.id }}/n/{{ target.id }}" hx-trigger="change"
      hx-vals='{"autosave": "1"}' hx-target="#debrief-status">
  {% for f in r.fields %}<input type="hidden" name="only" value="{{ f.name }}">{% endfor %}
  {% if r.label is not null %}<span class="row-label">{{ r.label }}</span>{% endif %}
  {% for f in r.fields %}{% include "node/_field.peb" %}{% endfor %}
  {% if r.done %}<button type="button" class="secondary" hx-post="/c/{{ campaign.id }}/n/{{ target.id }}"
                         hx-vals='{"autosave": "1", "clear": "1", "refresh": "1"}' hx-target="#debrief-status">Done</button>{% endif %}
</form>
