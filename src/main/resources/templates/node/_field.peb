{# One props field; included per field by _form.peb (variable f). #}
<div class="field"{% if f.conditional %} data-conditions="{{ f.conditionsJson }}"{% endif %}{% if f.hidden %} hidden{% endif %}>
{% if f.kind == 'multi' %}
  <fieldset>
    <legend>{{ f.label }}</legend>
    {% for opt in f.options %}
      <label class="check"{% if f.hints[opt] is not null %} title="{{ f.hints[opt] }}"{% endif %}><input type="checkbox" name="{{ f.inputName }}" value="{{ opt }}" {% if f.value contains opt %}checked{% endif %}> {{ f.labels[opt] | default(opt) }}</label>
    {% endfor %}
  </fieldset>
{% elseif f.kind == 'select' %}
  <label>{% if f.row is null %}{{ f.label }}{% endif %}
    <select name="{{ f.inputName }}"{% if f.row is not null %} aria-label="{{ f.label }}"{% endif %}>
      <option value="">–</option>
      {% for opt in f.options %}<option value="{{ opt }}" {% if f.value == opt %}selected{% endif %}{% if f.hints[opt] is not null %} title="{{ f.hints[opt] }}"{% endif %}>{{ f.labels[opt] | default(opt) }}</option>{% endfor %}
    </select>
  </label>
{% elseif f.kind == 'int' %}
  <label>{{ f.label }}
    <input type="number" name="{{ f.inputName }}" value="{{ f.value }}"
           {% if f.min is not null %}min="{{ f.min }}"{% endif %} {% if f.max is not null %}max="{{ f.max }}"{% endif %}>
  </label>
{% elseif f.kind == 'bool' %}
  <label class="check"><input type="checkbox" name="{{ f.inputName }}" {% if f.value %}checked{% endif %}> {{ f.label }}</label>
{% elseif (f.kind == 'textarea' or f.kind == 'list') and fieldViews[f.name] is not null %}
  {# Formatted like notes; a "list" (items separated by a blank line) gets an item from its Random button instead of a new text #}
  {% include "node/_long_text.peb" with {"key": f.name, "label": f.label, "name": f.inputName, "value": f.value, "html": fieldViews[f.name],
      "rows": f.kind == 'list' ? 5 : 3, "random": random[f.name], "append": f.kind == 'list'} %}
{% elseif f.kind == 'textarea' or f.kind == 'list' %}
  <label class="wide">{{ f.label }}<textarea name="{{ f.inputName }}" rows="{{ f.kind == 'list' ? 5 : 3 }}">{{ f.value }}</textarea>{% if random[f.name] is not null %}{% include "node/_random.peb" with {"field": f.inputName, "choices": random[f.name], "append": f.kind == 'list'} %}{% endif %}</label>
{% else %}
  <label{% if f.row is not null %} class="grow"{% elseif f.wide %} class="wide"{% endif %}>{% if f.row is null %}{{ f.label }}{% endif %}<span class="with-random"><input name="{{ f.inputName }}" value="{{ f.value }}"{% if f.row is not null %} aria-label="{{ f.label }}"{% endif %}>{% if random[f.name] is not null %}{% include "node/_random.peb" with {"field": f.inputName, "choices": random[f.name]} %}{% endif %}</span></label>
{% endif %}
</div>
