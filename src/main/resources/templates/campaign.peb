{% extends "layout.peb" %}

{% block title %}{{ campaign.name }}{% endblock %}
{% block crumbs %}<span class="sep">/</span> {{ campaign.name }}{% endblock %}

{% block content %}
<h1>{{ campaign.name }}</h1>

{% if sections is not empty %}
  <input type="search" class="overview-filter" aria-label="Filter" autocomplete="off">
{% endif %}

{# One table per type; columns from the module's "overview" settings plus link slots (e.g. Location) #}
{% for s in sections %}
  <section class="overview-section">
    <h2>{{ s.label }}</h2>
    <div class="table-scroll">
      <table class="overview">
        {% if s.columns is not empty %}
          <thead><tr><th></th>{% for col in s.columns %}<th>{{ col.label }}</th>{% endfor %}</tr></thead>
        {% endif %}
        <tbody>
          {% for r in s.rows %}
            <tr class="overview-row{% if r.muted %} muted-row{% endif %}">
              <td>{% include "node/_icon.peb" with {"type": r.type, "code": r.code} %} <a href="/c/{{ campaign.id }}/n/{{ r.id }}">{{ r.title }}</a></td>
              {% for cell in r.cells %}<td>{{ cell }}</td>{% endfor %}
            </tr>
            {% for ch in r.children %}
              <tr class="overview-row child{% if ch.muted %} muted-row{% endif %}">
                <td colspan="{{ (s.columns | length) + 1 }}">{% include "node/_icon.peb" with {"type": ch.type, "code": ch.code} %} <a href="/c/{{ campaign.id }}/n/{{ ch.id }}">{{ ch.title }}</a></td>
              </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {# Same as Add in the top bar, for this table's type: named from its random tables (or "New ..."), then opened #}
    {% if s.creatable %}
      <form class="section-create" method="post" action="/c/{{ campaign.id }}/nodes">
        <input type="hidden" name="type" value="{{ s.typeId }}">
        <button class="secondary">Create</button>
      </form>
    {% endif %}
  </section>
{% endfor %}
{% endblock %}
