{% extends "layout.peb" %}

{% block title %}{{ campaign.name }}{% endblock %}
{% block crumbs %}<span class="sep">/</span> {{ campaign.name }}{% endblock %}

{% block content %}
{# The name autosaves like a node's title; #save-status shows nothing unless something goes wrong. The ⋯ menu as on node pages:
   Export (the whole campaign as one file, a backup or to import as a copy on the home page) and Delete #}
<div class="title-bar page-title">
  <form class="title-form" hx-post="/c/{{ campaign.id }}" hx-trigger="change, submit" hx-target="#save-status">
    <input class="title-input" name="name" value="{{ campaign.name }}" aria-label="Name" required>
  </form>
  <details class="dropdown more-menu">
    <summary class="secondary" aria-label="More" title="More"><span class="type-icon" aria-hidden="true"><svg><use href="/static/icons.svg#ellipsis"/></svg></span></summary>
    <div class="menu dropdown-choices">
      <a class="menu-item" href="/c/{{ campaign.id }}/export.json">Export</a>
      <button type="button" class="menu-item" hx-post="/c/{{ campaign.id }}/delete"
              hx-confirm="Delete {{ campaign.name }} and everything in it? This can't be undone; Export first to keep a copy.">Delete</button>
    </div>
  </details>
</div>
<div id="save-status" aria-live="polite"></div>

{% if sections is not empty %}
  <input type="search" class="overview-filter" aria-label="Filter" autocomplete="off">
{% endif %}

{# One table per type; columns from the module's "overview" settings plus link slots (e.g. Location) #}
{% for s in sections %}
  <section class="overview-section">
    <h2>{{ s.label }}</h2>
    <div class="table-scroll">
      <table class="overview">
        {% if s.columns is not empty %}
          <thead><tr><th></th>{% for col in s.columns %}<th>{{ col.label }}</th>{% endfor %}</tr></thead>
        {% endif %}
        <tbody>
          {% for r in s.rows %}
            <tr class="overview-row{% if r.muted %} muted-row{% endif %}">
              <td>{% include "node/_icon.peb" with {"type": r.type, "code": r.code} %} <a href="/c/{{ campaign.id }}/n/{{ r.id }}">{{ r.title }}</a></td>
              {% for cell in r.cells %}<td>{{ cell }}</td>{% endfor %}
            </tr>
            {% for ch in r.children %}
              <tr class="overview-row child{% if ch.muted %} muted-row{% endif %}">
                <td colspan="{{ (s.columns | length) + 1 }}">{% include "node/_icon.peb" with {"type": ch.type, "code": ch.code} %} <a href="/c/{{ campaign.id }}/n/{{ ch.id }}">{{ ch.title }}</a></td>
              </tr>
            {% endfor %}
          {% endfor %}
        </tbody>
      </table>
    </div>
    {# Same as Create ▾ in the top bar, for this table's type: named from its random tables (or "New ..."), then opened #}
    {% if s.creatable %}
      <form class="section-create" method="post" action="/c/{{ campaign.id }}/nodes">
        <input type="hidden" name="type" value="{{ s.typeId }}">
        <button class="secondary">Create</button>
      </form>
    {% endif %}
  </section>
{% endfor %}
{% endblock %}
