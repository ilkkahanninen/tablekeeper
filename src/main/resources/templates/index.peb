{% extends "layout.peb" %}

{% block content %}
<h1>Campaigns</h1>

{% if campaigns is not empty %}
  <section class="overview-section table-scroll">
    <table class="overview">
      <thead><tr><th>Campaign</th><th>Game</th></tr></thead>
      <tbody>
        {% for c in campaigns %}
          <tr><td><a href="/c/{{ c.id }}">{{ c.name }}</a></td><td>{{ games[c.gameModule] | default(c.gameModule) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
{% endif %}

<form class="card stack" method="post" action="/campaigns">
  <h2>New campaign</h2>
  <label>Name <input name="name" required></label>
  <label>Game
    <select name="module">
      {% for m in modules %}<option value="{{ m.id }}">{{ m.name }}</option>{% endfor %}
    </select>
  </label>
  <button>Create</button>
</form>

{# A file from a campaign's Export, always as a new campaign #}
<form class="card stack" method="post" action="/campaigns/import" enctype="multipart/form-data">
  <h2>Import campaign</h2>
  <label>File <input type="file" name="file" accept=".json,application/json" required></label>
  <button>Import</button>
</form>
{% endblock %}
