<!doctype html>
<html>
<head>
<meta charset="utf-8">
<title>{{ node.code }} {{ displayTitle }}</title>
<style>
  {% include "print/_fonts.peb" %}
  /* A node's print: A4 pages, as many as its text needs. */
  @page { size: A4; margin: 15mm; }
  body { font-size: 10pt; color: #111; margin: 0; line-height: 1.3; }
  .head { width: 100%; border-bottom: 0.6mm solid #111; margin-bottom: 2mm; border-collapse: collapse; }
  .head td { vertical-align: bottom; padding: 0 0 1mm 0; }
  .title { font-size: 15pt; font-weight: bold; }
  .subtitle { font-size: 9pt; color: #555; }
  .type { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.5pt; color: #555; }
  .code { font-size: 11pt; text-align: right; }
  .flag { font-size: 7pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5pt; color: #8c1c13; vertical-align: middle; }
  .props { width: 100%; border-collapse: collapse; margin-bottom: 2mm; }
  .props td { padding: 0.6mm 0; border-bottom: 0.2mm dotted #aaa; vertical-align: baseline; }
  .props td.k { width: 32mm; color: #555; font-size: 7.5pt; text-transform: uppercase; }
  /* Values from linked nodes (print/_linked_props.peb): a row per linked node, a column per value */
  table.linked { border-collapse: collapse; margin: 0 0 2mm; }
  .linked th { text-align: left; font-weight: normal; font-size: 7.5pt; text-transform: uppercase; color: #555; padding: 0.4mm 4mm 0.6mm 0; border-bottom: 0.2mm solid #aaa; }
  .linked td { padding: 0.6mm 4mm 0.6mm 0; border-bottom: 0.2mm dotted #aaa; vertical-align: baseline; }
  .body { margin: 2mm 0; }
  /* Formatted notes (Notes.html): paragraphs and lists; [[mentions]] in bold */
  .body p, .notes p { margin: 0 0 1.5mm; }
  .body ul, .notes ul { margin: 0 0 1.5mm; padding-left: 4.5mm; }
  .body > :last-child, .notes > :last-child { margin-bottom: 0; }
  .props td .body { margin: 0; }
  h4 { font-size: 7.5pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5pt; margin: 3mm 0 1mm; color: #555; break-after: avoid; }
  ul { margin: 0; padding-left: 4mm; list-style: disc; }
  li { margin: 0 0 0.8mm 0; }
  ul.nested { list-style: circle; margin-top: 0.8mm; }
  .ref { font-size: 8pt; }
  .fact { margin: 0 0 1.5mm 0; }
  .fact .t, .detail .t, .props .t { font-weight: bold; }
  .detail { margin: 0 0 1mm 0; }
  .box { display: inline-block; width: 2.6mm; height: 2.6mm; border: 0.3mm solid #111; margin-right: 1mm; vertical-align: -0.3mm; }
  /* Resistance track ("x-track") and events ("list", formatted like notes), ticked off at the table */
  .track { line-height: 6mm; }
  .pip { display: inline-block; width: 4.6mm; height: 4.6mm; line-height: 4.6mm; border: 0.3mm solid #111; margin: 0 0.8mm 0.8mm 0;
         text-align: center; font-size: 6pt; color: #777; vertical-align: middle; }
  .item { margin: 0 0 1.5mm 0; }
  .item .box + p { display: inline; }
  .item p { margin: 0 0 1mm; }
  .item ul { margin: 0 0 1mm; padding-left: 4.5mm; }
  .foot { font-size: 6.5pt; color: #888; margin-top: 3mm; }
</style>
</head>
<body>
<div class="card">
  <table class="head"><tr>
    <td><div class="type">{{ typeLabel }}{% if audience == 'players' %} · handout{% endif %}</div><div class="title">{{ displayTitle }}{% for f in flags %} <span class="flag">{{ f }}</span>{% endfor %}</div>{% if subtitle is not empty %}<div class="subtitle">{{ subtitle }}</div>{% endif %}</td>
    <td class="code">{{ node.code }}</td>
  </tr></table>

  {% block main %}{% endblock %}

  <div class="foot">{{ campaign.name }}</div>
</div>
</body>
</html>
