<!doctype html>
{#
  Session packet (the default print of a type with a `packet`): one brief landscape A4 document, in two parts (variable `part`):
  - "cover": the session's title and date, the whole map with the selected places filled red, and the session's notes
    ("This time") after the previous session's recap; with a portrait map the page is two columns, the map on the left at
    full height and everything else on the right;
    with a previous session's recap (packet "recap"), that recap beside the map, "Last time"; a portrait map (the
    module's mapOrientation) sits on the left at the page's height, the recap beside it;
  - "columns": each module view over the selected nodes (its `print` partial, e.g. Heart's characters' Inspiration), then a
    section per type of the selected and nearby nodes, each entry drawn by print/_body.peb.
    Laid out as one column on narrow pages, which the app places side by side (packet "columns"). The PDF renders one
    section at a time (variable `only`: "story" on the campaign's print, "view:<id>" or "section:<type id>") without its h2: the app draws section
    headings across their columns on each sheet.
  No part (the HTML preview) shows both. Model: the session's print model plus map, views, sections.
#}
<html>
<head>
<meta charset="utf-8">
<title>{{ node.code }} {{ node.title }}</title>
<style>
  {% include "print/_fonts.peb" %}
  @page { size: A4 landscape; margin: 10mm; }
  body { font-size: 9.5pt; color: #111; margin: 0; line-height: 1.3; }
  header { border-bottom: 0.6mm solid #111; margin-bottom: 2mm; }
  h1 { font-size: 15pt; margin: 0 0 1mm; }
  .date { font-size: 9pt; color: #555; margin-left: 2mm; font-weight: normal; }
  .notes { margin: 1mm 0 2mm; }
  .code, .ref { font-size: 8pt; color: #555; }
  h2 { font-size: 9pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.6pt; color: #8c1c13; border-bottom: 0.3mm solid #8c1c13; margin: 4mm 0 2mm; padding-bottom: 0.5mm; page-break-after: avoid; }
  .text > h2:first-child { margin-top: 0; }
  /* Entries are spaced below, not above their titles: one that starts a column then sits right under the heading band */
  h3 { font-size: 12pt; margin: 0 0 1mm; page-break-after: avoid; }
  .place { page-break-inside: avoid; margin-bottom: 6mm; }
  .recap { margin-bottom: 4mm; }
  .flag { font-size: 7pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5pt; color: #8c1c13; vertical-align: middle; }

  /* Entry body (print/_body.peb), as on the cards */
  .props { border-collapse: collapse; margin-bottom: 1.5mm; }
  /* Values from linked nodes (print/_linked_props.peb): a row per linked node, a column per value */
  table.linked { border-collapse: collapse; margin: 0 0 2mm; }
  .linked th { text-align: left; font-weight: normal; font-size: 7.5pt; text-transform: uppercase; color: #555; padding: 0.4mm 4mm 0.6mm 0; border-bottom: 0.2mm solid #aaa; }
  .linked td { padding: 0.6mm 4mm 0.6mm 0; border-bottom: 0.2mm dotted #aaa; vertical-align: baseline; }
  .props td { padding: 0.4mm 3mm 0.4mm 0; vertical-align: baseline; }
  .props td.k { color: #555; font-size: 7.5pt; text-transform: uppercase; white-space: nowrap; }
  .props .t, .detail .t, .fact .t { font-weight: bold; }
  .body { margin: 1mm 0; }
  /* Formatted notes (Notes.html): paragraphs and lists; [[mentions]] in bold */
  .body p, .notes p { margin: 0 0 1.5mm; }
  .body ul, .notes ul { margin: 0 0 1.5mm; padding-left: 4.5mm; }
  .body > :last-child, .notes > :last-child { margin-bottom: 0; }
  .props td .body { margin: 0; }
  h4 { font-size: 7.5pt; font-weight: normal; text-transform: uppercase; letter-spacing: 0.5pt; color: #555; margin: 2mm 0 0.5mm; break-after: avoid; }
  ul { margin: 0; padding-left: 4.5mm; list-style: disc; }
  li { margin: 0 0 0.6mm 0; }
  ul.nested { list-style: circle; margin-top: 0.6mm; }
  .fact, .detail { margin: 0 0 1mm 0; }
  /* Resistance track ("x-track") and events ("list", formatted like notes), ticked off at the table */
  .track { line-height: 6mm; }
  .pip { display: inline-block; width: 4.6mm; height: 4.6mm; line-height: 4.6mm; border: 0.3mm solid #111; margin: 0 0.8mm 0.8mm 0;
         text-align: center; font-size: 6pt; color: #777; vertical-align: middle; }
  .item { margin: 0 0 1.5mm 0; }
  .item .box + p { display: inline; }
  .item p { margin: 0 0 1mm; }
  .item ul { margin: 0 0 1mm; padding-left: 4.5mm; }
  .box { display: inline-block; width: 2.6mm; height: 2.6mm; border: 0.3mm solid #111; margin-right: 1mm; vertical-align: -0.3mm; }

  /* Module views' packet partials (Heart's characters, heart/print/_inspiration_packet.peb) */
  .muted, .small { color: #555; font-size: 8.5pt; }
  .beats { margin: 0 0 1mm; }
  .beat-type { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.4pt; color: #8c1c13; margin-right: 1mm; }
  .wants { margin: 0.5mm 0 0; }
  .linked-label { font-size: 7pt; text-transform: uppercase; letter-spacing: 0.4pt; color: #555; margin: 1.5mm 0 0.3mm; break-after: avoid; }
  .character { page-break-inside: avoid; margin-bottom: 6mm; }
  .role { color: #555; font-size: 8.5pt; margin: 0 0 0.5mm; }

  /* Cover with the previous session's recap ("Last time") beside the map */
  table.cover { border-collapse: collapse; width: 100%; }
  /* Portrait map: the page in two equal columns, the map filling the left one */
  table.halves { table-layout: fixed; }
  .halves td { width: 50%; }
  .halves header { margin-bottom: 4mm; }
  .cover td { vertical-align: top; padding: 0; }
  .last-time { padding-left: 5mm; }
  .last-time h2 { margin-top: 0; }
  /* Each cover list after the first (This time, To reveal, the module's soFar) starts a little lower */
  .last-time h2 ~ h2 { margin-top: 5mm; }
  .so-far { list-style: none; padding-left: 0; }
</style>
</head>
<body>
  {% if part != 'columns' %}
  <div class="map-page">
    {% if map.height > map.width %}
      {# A portrait map (e.g. Heart's tiers): two columns, the map on the left at the page's full height, the title,
         the previous session's recap and this session's notes on the right #}
      <table class="cover halves"><tr>
        <td class="cover-map">{% if map.places is not empty %}{% include "map/_svg.peb" with {"links": false, "svgWidth": 482, "svgHeight": 682} %}{% endif %}</td>
        <td class="last-time">
          {% include "print/_session_head.peb" %}
          {% include "print/_session_recap.peb" %}
        </td>
      </tr></table>
    {% else %}
      {% include "print/_session_head.peb" %}
      {% if previous is not null or roster is not empty %}
        {# The previous session's recap (or the campaign's roster) beside a smaller map, so the cover stays one page #}
        <table class="cover"><tr>
          <td class="cover-map">{% if map.places is not empty %}{% include "map/_svg.peb" with {"links": false, "svgWidth": 760, "svgHeight": 537} %}{% endif %}</td>
          <td class="last-time">{% include "print/_session_recap.peb" %}</td>
        </tr></table>
      {% else %}
        {% if map.places is not empty %}{% include "map/_svg.peb" with {"links": false, "svgWidth": 1000, "svgHeight": 640} %}{% endif %}
        {% include "print/_session_recap.peb" %}
      {% endif %}
    {% endif %}
  </div>
  {% endif %}

  {% if part != 'cover' %}
  <div class="text">
  {# The campaign's print: every session's recap, oldest first #}
  {% if story is not empty and (only is null or only == 'story') %}
    {% if only is null %}<h2>{{ storyHeading }}</h2>{% endif %}
    {% for r in story %}
      <div class="recap">
        <h3><span class="code">{{ r.code }}</span> {{ r.title }}</h3>
        <div class="body">{{ r.notes | raw }}</div>
      </div>
    {% endfor %}
  {% endif %}

  {% for v in views %}{% if v.view.print is not null and (only is null or only == 'view:' ~ v.view.id) %}
    {% if only is null %}<h2>{{ viewHeadings[v.view.id] }}</h2>{% endif %}
    {% include v.view.print with {"v": v} %}
  {% endif %}{% endfor %}

  {% for s in sections %}{% if only is null or only == 'section:' ~ s.typeId %}
    {% if only is null %}<h2>{{ s.label }}</h2>{% endif %}
    {% for item in s.items %}
      <div class="place">
        <h3><span class="code">{{ item.node.code }}</span> {{ item.displayTitle }}{% for f in item.flags %} <span class="flag">{{ f }}</span>{% endfor %}</h3>
        {% if item.subtitle is not empty %}<div class="role">{{ item.subtitle }}</div>{% endif %}
        {# Pebble's include takes a literal map: pass the entry's print model through #}
        {% include "print/_body.peb" with {"node": item.node, "props": item.props, "linkedPropTables": item.linkedPropTables,
            "groups": item.groups, "facts": item.facts, "audience": item.audience, "notes": item.notes,
            "nodeMap": item.nodeMap, "mapWidth": 320} %}
      </div>
    {% endfor %}
  {% endif %}{% endfor %}
  </div>
  {% endif %}
</body>
</html>
