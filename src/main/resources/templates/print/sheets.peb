<!doctype html>
{# What a session packet's column sheets show over their columns (Imposition): each section's heading across its
   columns, styled as the packet's h2, and the sheet's number. One landscape A4 page per sheet (variable sheets). #}
<html>
<head>
<meta charset="utf-8">
<style>
  {% include "print/_fonts.peb" %}
  @page { size: A4 landscape; margin: 0; }
  body { margin: 0; color: #111; }
  .sheet { position: relative; width: 297mm; height: 210mm; overflow: hidden; break-after: page; }
  .sheet:last-child { break-after: auto; }
  h2 { position: absolute; margin: 0; font-size: 9pt; font-weight: normal; line-height: 1.3; text-transform: uppercase; letter-spacing: 0.6pt;
       color: #8c1c13; border-bottom: 0.3mm solid #8c1c13; padding-bottom: 0.5mm; white-space: nowrap; overflow: hidden; }
  .number { position: absolute; font-size: 7pt; color: #888; }
</style>
</head>
<body>
{% for s in sheets %}
  <div class="sheet">
    {% for h in s.headings %}<h2 style="left: {{ h.leftMm }}mm; width: {{ h.widthMm }}mm; top: {{ s.topMm }}mm">{{ h.text }}</h2>{% endfor %}
    <div class="number" style="right: {{ s.marginMm }}mm; bottom: 4mm">{{ s.number }}</div>
  </div>
{% endfor %}
</body>
</html>
