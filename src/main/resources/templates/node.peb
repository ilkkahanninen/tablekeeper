{% extends "layout.peb" %}

{% block title %}{{ displayTitle }}{% endblock %}
{% block crumbs %}
  <span class="sep">/</span> <a href="/c/{{ campaign.id }}">{{ campaign.name }}</a>
  <span class="sep">/</span> {{ displayTitle }}
{% endblock %}

{% block content %}
<div class="node-page">
  {# Across both columns: the type line, then the title with the node's ⋯ menu on its right #}
  <div class="node-head">
    <p class="muted small">{% include "node/_icon.peb" with {"type": node.type, "code": node.code} %} {{ typeLabel }} · <a href="/c/{{ campaign.id }}/n/{{ node.id }}/print.pdf" target="_blank">Print</a>{% if hasMap %} · <a href="/c/{{ campaign.id }}/n/{{ node.id }}/map">Map</a>{% endif %}</p>
    <div class="title-bar">
      {% include "node/_title.peb" %}
      <details class="dropdown more-menu">
        <summary class="secondary" aria-label="More" title="More"><span class="type-icon" aria-hidden="true"><svg><use href="/static/icons.svg#ellipsis"/></svg></span></summary>
        <div class="menu dropdown-choices">
          {# Duplicate waits for an autosave still on its way (hx-sync), so the copy has the last edit #}
          <button type="button" class="menu-item" hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/duplicate" hx-sync="#node-form:queue all">Duplicate</button>
          <button type="button" class="menu-item" hx-post="/c/{{ campaign.id }}/n/{{ node.id }}/delete"
                  hx-confirm="Delete {{ node.code }} {{ node.title }} and all its links?">Delete</button>
        </div>
      </details>
    </div>
  </div>

  <div class="main-col">
    {% include "node/_slots.peb" %}
    {% include "node/_checklists.peb" %}
    {% include "node/_linked_props.peb" %}
    {% include "node/_form.peb" %}
    {% if debrief is not empty %}{% include "node/_debrief.peb" %}{% endif %}
  </div>

  <aside class="side-col">
    {# Link box: type to find something to link; click a result to link it #}
    <section class="card">
      <h2>Link</h2>
      <form class="link-picker"
            hx-get="/c/{{ campaign.id }}/n/{{ node.id }}/link-search"
            hx-trigger="input delay:200ms, submit, links-changed from:body"
            hx-target="#link-results">
        <span class="type-icon find-icon" aria-hidden="true"><svg><use href="/static/icons.svg#search"/></svg></span>
        <input id="link-q" name="q" type="search" aria-label="Find" autocomplete="off">
      </form>
      <div id="link-results"></div>
    </section>

    {% include "node/_create.peb" %}

    {% include "node/_linked.peb" %}
  </aside>
</div>
{% endblock %}
